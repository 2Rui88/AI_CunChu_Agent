# 复制为 docker/.env 并修改所有默认值后再启动
#   cp docker/.env.example docker/.env

# MySQL root 密码（必填，为空时 mysql 容器无法启动）
MYSQL_ROOT_PASSWORD=change-me-mysql-root

# MinIO 管理员账号密码（后端使用同一组凭据访问对象存储）
MINIO_ROOT_USER=change-me-minio-user
MINIO_ROOT_PASSWORD=change-me-minio-password

# 对外访问地址（生成预签名下载 URL 用；浏览器与 DashScope 必须可达）
# 公网/正式部署：填服务器 IP 或域名，走 Nginx 443 HTTPS
# PUBLIC_SERVER_IP=your-domain.com
# PUBLIC_SERVER_PORT=443
# PUBLIC_SERVER_SSL=true
